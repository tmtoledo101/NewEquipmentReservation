{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "new-equiment-reservation-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/newEquimentReservation/NewEquimentReservationWebPart.js",
          "manifest": "./src/webparts/newEquimentReservation/NewEquimentReservationWebPart.manifest.json"
        }
      ]
    },
    "view-new-equipment-request-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/viewNewEquipmentRequest/ViewNewEquipmentRequestWebPart.js",
