          "manifest": "./src/webparts/displayNewEquipmentRequest/DisplayNewEquipmentRequestWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "NewEquimentReservationWebPartStrings": "lib/webparts/newEquimentReservation/loc/{locale}.js",
    "ViewNewEquipmentRequestWebPartStrings": "lib/webparts/viewNewEquipmentRequest/loc/{locale}.js",
